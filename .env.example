# Local Docker Compose demo only. Do not use these credentials in production.
POSTGRES_DB=image_processor
POSTGRES_USER=image_processor
POSTGRES_PASSWORD=image_processor
RABBITMQ_DEFAULT_USER=image_processor
RABBITMQ_DEFAULT_PASS=image_processor

# Containers reach dependencies by Compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://image_processor:image_processor@db:5432/image_processor
RABBITMQ_URL=amqp://image_processor:image_processor@rabbitmq:5672
BLOB_STORAGE_PATH=/data/images
