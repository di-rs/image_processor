    "build": "vite build",
    "start": "node --env-file-if-exists=.env scripts/start.js"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@tanstack/svelte-query": "^5.90.2",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "^26.6.4",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "7.3.6",
    "vitest": "^5.0.3"
  }
}
