# Fixed upstream origin, reached only by the SvelteKit server.
BACKEND_URL=http://127.0.0.1:8000

# Local-only production listener (pnpm dev binds loopback separately).
HOST=127.0.0.1
PORT=3000
ORIGIN=http://127.0.0.1:3000
# Adapter-node request limit; preview downloads are separately capped at 20 MiB.
BODY_SIZE_LIMIT=50M

# Optional browser-facing links; no credentials.
PUBLIC_API_DOCS_URL=http://localhost:8000/docs
PUBLIC_RABBITMQ_URL=http://localhost:15672
